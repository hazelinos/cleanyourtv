<?xml version="1.0" encoding="utf-8"?>
<!-- Remote buttons page: the owner's in-app button mappings (RemoteMappings). Same shell as
     Launcher settings; the mapping rows are built in code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_buttons"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/remote_buttons_hint"
            android:textColor="#FFACB8C1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/captureHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/remap_press_button"
            android:textColor="#FFB9E7C7"
            android:textSize="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/addChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/remap_add" />

        <TextView
            android:id="@+id/resetChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/remap_reset" />
    </LinearLayout>
</ScrollView>
