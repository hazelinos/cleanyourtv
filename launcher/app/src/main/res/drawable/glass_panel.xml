<?xml version="1.0" encoding="utf-8"?>
<!-- Glass panel for popups, menus and dialogs: a dark translucent slab whose gradient lightens
     towards the top (the sheen) with a thin light rim, so the wallpaper stays visible behind it
     (Apple TV / visionOS style). Local translucency only: no blur pass, one shape draw. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#F233333A" android:endColor="#F5141418" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
    <corners android:radius="22dp" />
</shape>
