<?xml version="1.0" encoding="utf-8"?>
<!-- Text on settings rows: dark on the solid white focus, white otherwise (same rule as pill_text). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF111111" />
    <item android:color="#FFFFFFFF" />
</selector>
