<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for a MovieBox tile shown as Netflix (config.xml, app_banners; see AppPresentation):
     a black field with the red "N". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF1A1A1A" android:endColor="#FF000000" />
        </shape>
    </item>
    <item android:width="76dp" android:height="76dp" android:gravity="center"
        android:drawable="@drawable/ic_netflix_n" />
</layer-list>
