<?xml version="1.0" encoding="utf-8"?>
<!-- A tile with no banner of its own: dark glass, slightly translucent with a hairline rim, so the
     wallpaper ghosts through like the rest of the glass UI. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#D91C1C1E" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
    <corners android:radius="16dp" />
</shape>
